includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # このトレイトは resources/views/pages/settings/⚡profile.blade.php（Livewire の単一ファイルコンポーネント）で使う。
        # PHPStan は Blade を読まないため「使われていない」と判定される。会員登録を外したので PHP 側の利用がなくなった
        -
            identifier: trait.unused
            path: app/Concerns/ProfileValidationRules.php
